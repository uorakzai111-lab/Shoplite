# Copy to .env and replace the dummy values. Never commit .env.

# Postgres container
POSTGRES_DB=shopdb
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me

# Every backend
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shopdb
DB_USER=shop
DB_PASSWORD=change-me

# order-service only
CATALOG_URL=http://catalog:3000
INVENTORY_URL=http://inventory:8081

# frontend (nginx server_name)
SERVER_NAME=shoplite.test
